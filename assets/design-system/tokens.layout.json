{
  "frame": {
    "width": "1728px",
    "height": "1152px"
  },
  "window": {
    "min-width": "1100px",
    "min-height": "720px",
    "max-width": "none",
    "resize": "fluid-desktop"
  },
  "shell": {
    "titlebar-height": "64px",
    "sidebar-width": "240px",
