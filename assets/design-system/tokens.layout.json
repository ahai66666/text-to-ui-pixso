    "primary-action-slot-gap-top": "space.3",
    "primary-action-slot-gap-bottom": "space.4",
    "secondary-list-card-inset-x": "space.5",
    "secondary-list-card-padding-x": "space.3",
    "secondary-content-axis-x": "space.6",
    "secondary-pane-padding-x": "space.5",
    "secondary-pane-padding-y": "space.3",
    "main-detail-padding-x": "space.6",
    "main-detail-padding-top": "space.5",
    "main-detail-padding-bottom": "space.0"
