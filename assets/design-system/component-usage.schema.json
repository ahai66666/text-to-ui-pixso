{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text-to-ui.local/component-usage.schema.json",
  "title": "Text-to-UI component usage manifest",
  "oneOf": [
    { "$ref": "#/$defs/legacy" },
    { "$ref": "#/$defs/strictHtml" },
    { "$ref": "#/$defs/strictWeb" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schemaVersion", "targetFramework", "sourceRoots", "registered", "contractBased", "custom", "previousOutputReuse"],
      "properties": {
        "sourceRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "registered": { "type": "array" },
        "contractBased": { "type": "array" },
        "custom": { "type": "array" },
        "previousOutputReuse": { "const": false }
      }
    },
    "legacy": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "schemaVersion": { "const": 1 }, "targetFramework": { "const": "html" } } }
      ]
    },
    "strictRegistered": {
      "type": "object",
      "required": ["logicalName", "rendererKey", "usage", "requiredCallSites", "expectedRuntimeCount", "readinessLevel", "unresolvedParity"],
      "properties": {
        "logicalName": { "type": "string", "minLength": 1 },
        "rendererKey": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "minLength": 1 },
        "requiredCallSites": { "type": "integer", "minimum": 1 },
        "expectedRuntimeCount": { "type": "integer", "minimum": 1 },
        "readinessLevel": { "enum": ["approved", "provisional", "blocked"] },
        "unresolvedParity": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "regions": { "type": "array", "items": { "type": "string" } },
        "requiredRuntimeSlots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reviewedCandidate": {
      "type": "object",
      "required": ["logicalName", "rejectionReason"],
      "properties": {
        "logicalName": { "type": "string", "minLength": 1 },
        "rejectionReason": { "type": "string", "minLength": 1 }
      }
    },
    "pageOwnedBase": {
      "type": "object",
      "required": ["id", "missingCapability", "registryQueries", "reviewedCandidates", "tokenRoles", "disposition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "missingCapability": { "type": "string", "minLength": 1 },
        "registryQueries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reviewedCandidates": { "type": "array", "items": { "$ref": "#/$defs/reviewedCandidate" } },
        "tokenRoles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "disposition": { "enum": ["page-owned", "promote-to-library"] },
        "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "strictContractBased": {
      "allOf": [
        { "$ref": "#/$defs/pageOwnedBase" },
        {
          "required": ["contractLogicalName", "contractEvidence"],
          "properties": {
            "contractLogicalName": { "type": "string", "minLength": 1 },
            "contractEvidence": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "strictCustom": {
      "allOf": [
        { "$ref": "#/$defs/pageOwnedBase" },
        {
          "required": ["contractQueries", "exceptionKind"],
          "properties": {
            "contractQueries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "exceptionKind": { "enum": ["no-matching-component", "specialized-business-surface"] }
          }
        }
      ]
    },
    "strictWebRegistered": {
      "type": "object",
      "required": ["logicalName", "usage", "requiredCallSites", "expectedRuntimeCount", "readinessLevel", "unresolvedParity"],
      "properties": {
        "logicalName": { "type": "string", "minLength": 1 },
        "rendererKey": { "type": ["string", "null"] },
        "exportName": { "type": ["string", "null"] },
        "usage": { "type": "string", "minLength": 1 },
        "requiredCallSites": { "type": "integer", "minimum": 1 },
        "expectedRuntimeCount": { "type": "integer", "minimum": 1 },
        "readinessLevel": { "enum": ["approved", "provisional", "blocked"] },
        "unresolvedParity": { "type": "array", "items": { "type": "string" } },
        "regions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "strictWeb": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["enforcement", "selection", "renderer", "layout"],
          "properties": {
            "schemaVersion": { "const": 3 },
            "targetFramework": { "const": "html" },
            "enforcement": { "const": "strict-source" },
            "selection": {
              "type": "object",
              "required": ["path", "sha256", "registryDigest"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "registryDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            },
            "renderer": { "type": "object", "required": ["package", "styleImports"] },
            "layout": { "type": "object", "required": ["contractPath", "pattern", "paneOrder", "structureDigest"] },
            "registered": { "type": "array", "items": { "$ref": "#/$defs/strictWebRegistered" } },
            "contractBased": { "type": "array", "items": { "$ref": "#/$defs/strictContractBased" } },
            "custom": { "type": "array", "items": { "$ref": "#/$defs/strictCustom" } }
          }
        }
      ]
    },
    "strictHtml": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
            "required": ["enforcement", "renderer", "layout"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "targetFramework": { "const": "html" },
            "enforcement": { "const": "strict-source" },
            "renderer": {
              "type": "object",
              "required": ["package", "factoryImport", "styleImports"],
              "properties": {
                "package": { "const": "@text-to-ui/components-html" },
                "factoryImport": { "const": "renderHtmlComponent" },
                "styleImports": { "type": "array", "minItems": 2, "items": { "type": "string" } }
              }
            },
            "layout": {
              "type": "object",
              "required": ["contractPath", "pattern", "paneOrder"],
              "properties": {
                "contractPath": { "type": "string", "minLength": 1 },
                "pattern": { "enum": ["pattern-a-two-pane", "pattern-b-three-pane", "pattern-c-tool-workspace", "pattern-d-inspector"] },
                "paneOrder": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            },
            "registered": { "type": "array", "items": { "$ref": "#/$defs/strictRegistered" } },
            "contractBased": { "type": "array", "items": { "$ref": "#/$defs/strictContractBased" } },
            "custom": { "type": "array", "items": { "$ref": "#/$defs/strictCustom" } }
          }
        }
      ]
    }
  }
}
