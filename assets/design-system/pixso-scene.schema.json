{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.text-to-ui/pixso-scene.schema.json",
  "title": "Text-to-UI Pixso native scene",
  "type": "object",
  "required": ["schemaVersion", "page", "resources", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "object" },
    "page": {
      "type": "object",
      "required": ["name", "viewport", "pattern", "stateScope"],
      "properties": {
        "name": { "type": "string" },
        "viewport": { "type": "object" },
        "pattern": { "type": "string" },
        "stateScope": { "const": "default-visible" }
      }
    },
    "resources": { "type": "object" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "name", "type", "region", "layout", "style"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "type": { "enum": ["frame", "text", "icon", "image", "rectangle", "ellipse", "component"] },
        "region": { "type": "string" },
        "layout": { "type": "object" },
        "style": { "type": "object" },
        "content": { "type": "string" },
        "icon": {
          "type": "object",
          "properties": {
            "alias": { "type": "string" },
            "size": { "type": "number", "exclusiveMinimum": 0 },
            "hotZone": {
              "type": "object",
              "properties": {
                "alignment": { "const": "CENTER" },
                "axes": { "const": "BOTH" }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "required": ["ref"],
          "properties": {
            "ref": { "type": "string" },
            "fit": { "enum": ["FILL", "FIT", "CROP", "TILE"] }
          }
        },
        "component": { "type": "object" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
