{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.text-to-ui/pixso-operation-plan.schema.json",
  "title": "Text-to-UI Pixso operation plan",
  "type": "object",
  "required": ["schemaVersion", "kind", "execution", "page", "operations"],
  "$defs": {
    "hotZone": {
      "type": "object",
      "required": ["alignment", "axes"],
      "properties": {
        "alignment": { "const": "CENTER" },
        "axes": { "const": "BOTH" },
        "overflow": { "const": "VISIBLE" },
        "verificationTolerance": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "iconSlot": {
      "type": "object",
      "required": ["alias", "size", "hotZone"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "hotZone": { "$ref": "#/$defs/hotZone" }
      },
      "additionalProperties": false
    },
    "iconRef": {
      "type": "object",
      "required": ["alias"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "hotZone": { "$ref": "#/$defs/hotZone" }
      },
      "additionalProperties": false
    },
    "componentRef": {
      "type": "object",
      "properties": {
        "logicalName": { "type": "string", "minLength": 1 },
        "pixsoName": { "type": ["string", "null"] },
        "componentSetName": { "type": ["string", "null"] },
        "variant": { "type": ["object", "null"] },
        "iconColorSource": { "const": "variant-content" },
        "contentColor": { "type": ["string", "object"] },
        "allowIconColorOverride": { "const": true },
        "allowContentColorOverride": { "const": true }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "pixso-operation-plan" },
    "execution": {
      "type": "object",
      "required": ["resolveGuidsAtRuntime", "libraryPage", "fallback", "agentContract"],
      "properties": {
        "agentContract": { "$ref": "../../protocol/operation-plan-v5.schema.json#/$defs/agentContract" }
      }
    },
    "page": { "type": "object" },
    "resources": { "type": "object" },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operationCount"],
        "properties": {
          "id": { "enum": ["resources", "layout", "icon-hydration", "image-optimization"] },
          "label": { "type": "string" },
          "operationCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operationCount"],
        "properties": {
          "id": { "enum": ["shell", "primary-navigation", "secondary-list", "main-detail", "icon-hydration", "image-optimization"] },
          "label": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "operationIds": { "type": "array", "items": { "type": "string" } },
          "operationIndexes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "operationCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": { "type": "string" },
          "phase": { "enum": ["resources", "layout", "icon-hydration", "image-optimization"] },
          "targetNodeId": { "type": "string" },
          "imageRef": { "type": "object" },
          "iconSlot": { "$ref": "#/$defs/iconSlot" },
          "iconRef": { "$ref": "#/$defs/iconRef" },
          "componentRef": { "$ref": "#/$defs/componentRef" }
        }
      }
    },
    "summary": { "type": "object" }
  }
}
