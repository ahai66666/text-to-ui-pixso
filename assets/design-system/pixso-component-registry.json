{
  "schemaVersion": 1,
  "library": "鸿蒙客户端设计规范",
  "pixso": {
    "componentLibraryPage": "NewComponents",
    "activePageMatch": "exact-name",
    "activePagePolicy": "resolve-and-repair-on-library-page-then-instantiate-on-target-page",
    "targetPageMayDiffer": true,
    "reuseRequiredFor": [
      "html-first",
      "visual-first"
    ]
  },
  "lookup": {
    "strategy": "exact-name",
    "idPolicy": "Resolve the current Pixso component GUID by exact name at runtime; never persist document GUIDs.",
    "instancePolicy": "Create an instance of an existing component. Do not redraw, detach, or recreate a registered component inside a page."
  },
  "rules": {
    "states": ["Default", "Normal", "Off", "Unchecked", "Unselected", "Collapsed"],
    "componentSets": false,
    "patterns": false,
    "requireAutoLayout": true,
    "requireTokenBindings": true,
    "iconSource": "assets/icons/icon-aliases.json",
    "forbidDuplicateSuffix": true
  },
  "categories": {
    "01 Actions": [
      "Button/Primary/Default",
      "Button/Secondary/Default",
      "Button/Ghost/Default",
      "Icon Text Button/Primary/Default",
      "Icon Text Button/Secondary/Default",
      "Icon Text Button/Ghost/Default",
      "Icon Button/Ghost/Default",
      "Icon Button/Secondary/Default",
      "Split Dropdown Button/Icon Text/Default",
      "Split Dropdown Button/Icon Only/Default",
      "Dropdown Menu/Default"
    ],
    "02 Chips": [
      "Chips/Default"
    ],
    "02 Forms": [
      "Form Field/Default",
      "Field/Default",
      "Field/With Description",
      "Input/White Surface/Default",
      "Input/Gray Surface/Default",
      "Input/Tag Entry/Default",
      "Search/White Surface/Default",
      "Search/Gray Surface/Default",
      "Search/Scoped/Default",
      "Textarea/White Surface/Default",
      "Textarea/Gray Surface/Default",
      "Select/White Surface/Default",
      "Select/Gray Surface/Default",
      "Combobox/White Surface/Default",
      "Combobox/Gray Surface/Default",
      "Input OTP/Default",
      "Number Selector/Default",
      "Checkbox/Unchecked/Default",
      "Radio/Unselected/Default",
      "Switch/Off/Default",
      "Slider/Default",
      "Segmented Button/Default",
      "ColorPicker/Tablet",
      "Selection Dropdown/Default",
      "Date Picker/Default",
      "Time Picker/Default"
    ],
    "03 Navigation": [
      "Titlebar/S/Normal",
      "Titlebar/M/Normal",
      "Titlebar/L/Normal",
      "Titlebar/XL/Normal",
      "Sidebar Item/Default",
      "Sidebar Group Header/Collapsed",
      "Primary Level Icon/Default",
      "Menubar/Default",
      "Tabs/Filled/Default",
      "Tabs/Line/Default",
      "Tabs/Vertical/Default",
      "Breadcrumb/Default",
      "Pagination/Default",
      "Pagination Item/Default",
      "Sub Tabs/Default",
      "Accordion/Collapsed",
      "Collapsible/Collapsed"
    ],
    "04 Data Display": [
      "Metric Card/Default",
      "List Item/White Surface/Default",
      "List Item/Gray Surface/Default",
      "List Container/White Canvas",
      "List Container/Gray Canvas",
      "Table/Default",
      "Table Header/Default",
      "Table Row/Default",
      "Badge/Neutral",
      "Badge/Info",
      "Badge/Success",
      "Badge/Warning",
      "Avatar/32/Image",
      "Avatar/32/Fallback",
      "Avatar/40/Image",
      "Avatar/40/Fallback",
      "Progress/Default"
    ],
    "05 Feedback": [
      "Alert/Info",
      "Alert/Success",
      "Alert/Error",
      "Alert/Warning",
      "Alert/Neutral",
      "Snackbar/Default",
      "Dialog/Default",
      "Tooltip/Default"
    ]
  },
  "semanticIcons": {
    "Icon Text Button/*": "action/add",
    "Icon Button/*": "action/more",
    "Split Dropdown Button/Icon Text/Default": ["action/add", "navigation/chevron-down"],
    "Split Dropdown Button/Icon Only/Default": ["action/add", "navigation/chevron-down"],
    "Search/*": "field/search",
    "Select/*": "navigation/chevron-down",
    "Combobox/*": "navigation/chevron-down",
    "Number Selector/Default": ["navigation/chevron-up", "navigation/chevron-down"],
    "Date Picker/Default": "field/date",
    "Time Picker/Default": "field/time",
    "Titlebar/*": ["window/minimize", "window/maximize", "window/close"],
    "Sidebar Item/Default": "navigation/inbox",
    "Sidebar Group Header/Collapsed": "navigation/chevron-down",
    "Primary Level Icon/Default": "navigation/grid",
    "Breadcrumb/Default": "navigation/chevron-right",
    "Accordion/Collapsed": "navigation/chevron-right",
    "Collapsible/Collapsed": "navigation/chevron-down",
    "Avatar/*/Image": "object/avatar",
    "Alert/Info": ["status/info", "action/close"],
    "Alert/Success": ["status/success", "action/close"],
    "Alert/Error": ["status/danger", "action/close"],
    "Alert/Warning": ["status/warning", "action/close"],
    "Alert/Neutral": ["status/neutral", "action/close"]
  }
}
