{
  "name": "text-to-ui-pixso",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "text-to-ui-pixso independent skill",
  "license": "MIT",
  "scripts": {
    "resources:build": "node scripts/build-resource-index.mjs --repo .",
    "resources:check": "node scripts/build-resource-index.mjs --repo . --check",
    "resources:query": "node scripts/query-resources.mjs",
    "catalog:build": "node scripts/build-skill-catalog-index.mjs",
    "catalog:check": "node scripts/build-skill-catalog-index.mjs --check",
    "index:build": "node scripts/build-navigation-index.mjs --repo . --skill-root .",
    "index:check": "node scripts/build-navigation-index.mjs --repo . --skill-root . --check",
    "workflow:route": "node scripts/resolve-workflow-route.mjs",
    "skill:manifest": "node scripts/skill-distribution.mjs manifest",
    "skill:check": "node scripts/skill-distribution.mjs check",
    "skill:pack": "node scripts/skill-distribution.mjs pack",
    "test": "node --test tests/*.test.mjs",
    "pixso:import": "node scripts/pixso-import-orchestrator.mjs",
    "pixso:import:compile": "node scripts/compile-pixso-import.mjs",
    "pixso:component-library:build": "node scripts/generate-pixso-component-library-plan.mjs",
    "pixso:component-facts:sync": "node scripts/pixso-component-facts-sync.mjs",
    "pixso:plugin:build": "node scripts/build-pixso-unified-agent-plugin.mjs",
    "services:start": "node scripts/start-text-to-ui-services.mjs start",
    "services:status": "node scripts/start-text-to-ui-services.mjs status",
    "handoff:check": "node scripts/html-handoff.mjs check",
    "data:sync": "node scripts/shared-data.mjs sync"
  },
  "dependencies": {
    "lucide": "1.24.0"
  }
}
